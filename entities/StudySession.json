{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "topic_title": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "summary",
        "flashcards",
        "quiz",
        "deep_dive",
        "mixed"
      ],
      "default": "mixed"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ],
      "default": "active"
    },
    "duration_minutes": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence_before": {
      "type": "number",
      "description": "1-5 scale"
    },
    "confidence_after": {
      "type": "number",
      "description": "1-5 scale"
    },
    "notes": {
      "type": "string"
    },
    "recap": {
      "type": "string",
      "description": "AI-generated session recap"
    }
  },
  "required": [
    "course_id",
    "topic_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}