{
  "name": "TopicMastery",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "mastery_level": {
      "type": "number",
      "default": 0,
      "description": "0-100"
    },
    "confidence": {
      "type": "number",
      "default": 0,
      "description": "1-5"
    },
    "total_study_time": {
      "type": "number",
      "default": 0
    },
    "sessions_count": {
      "type": "number",
      "default": 0
    },
    "last_session_date": {
      "type": "string",
      "format": "date-time"
    },
    "quiz_average": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "course_id",
    "topic_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}