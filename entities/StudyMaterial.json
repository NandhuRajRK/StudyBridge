{
  "name": "StudyMaterial",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "pdf",
        "slides",
        "notes",
        "reading",
        "other"
      ],
      "default": "pdf"
    },
    "file_url": {
      "type": "string",
      "description": "URL of uploaded file"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number",
      "description": "Size in bytes"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "processed",
        "error"
      ],
      "default": "uploaded"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "extracted_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topics extracted from material"
    }
  },
  "required": [
    "course_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}